# Database (Railway injects this when you link Postgres)
DATABASE_URL=postgres://verifyhub:verifyhub@localhost:5432/verifyhub

# Secrets: generate with `openssl rand -hex 32`
SESSION_SECRET=change-me-32-bytes-hex
RESULT_ENCRYPTION_KEY=change-me-64-hex-chars

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Payments: "mock" lets you simulate top-ups (never use in production with real users)
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=change-me

# Data providers: leave empty to use built-in mock data
NIN_API_URL=
NIN_API_KEY=
PASSPORT_API_URL=
PASSPORT_API_KEY=
TIN_API_URL=
TIN_API_KEY=

# Telegram (optional until you create the bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
