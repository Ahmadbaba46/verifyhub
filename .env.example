# Database (Railway injects this when you link Postgres)
DATABASE_URL=postgres://verifyhub:verifyhub@localhost:5432/verifyhub

# Secrets: generate with `openssl rand -hex 32`
SESSION_SECRET=change-me-32-bytes-hex
RESULT_ENCRYPTION_KEY=change-me-64-hex-chars

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Payments: "mock" lets you simulate top-ups (never use in production with real users)
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=change-me

# ---------------------------------------------------------------------------
# Provider layer — leave unconfigured to use built-in mock data
# ---------------------------------------------------------------------------

# Optional UA override for all providers.
# PROVIDER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:157.0) Gecko/20100101 Firefox/157.0

# --- NIN via POSSAP ---
# No API key needed; origin and referer are checked at their edge.
POSSAP_BASE=https://api.possap.ng
POSSAP_ORIGIN=https://possap.gov.ng

# --- BVN via Renmoney ---
# BOTH credentials are required for live BVN lookups.
#   RENMONEY_AES_KEY : 16-character AES-128 key (request/response body crypto)
#   SOURCE_APP_ID    : identifies the calling application to Renmoney
RENMONEY_BVN_URL=https://api-v3.renmoney.com/bvn/api/v3/validation
RENMONEY_AES_KEY=
SOURCE_APP_ID=
# Identifier key inside the encrypted payload: bvn | b
RENMONEY_PAYLOAD_KEY=bvn

# --- NIN + passport via the NIS portal ---
# mode:
#   read    validate the NIN and stop. Nothing is written upstream. (default)
#   compare validate, attach the passport, compare locally. Creates ONE case.
#   full    the above plus the portal's own comparison. Creates the case and
#           persists the passport data.
# compare and full write to a government system, so they are REFUSED unless
# NIS_ALLOW_WRITES=1 is set explicitly.
NIS_BASE=https://passport.immigration.gov.ng
NIS_MODE=read
NIS_ALLOW_WRITES=0
NIS_APPLYING_FOR=REISSUE

# Telegram (optional until you create the bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
